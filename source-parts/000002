    if not path.exists():return []
    result=[]
    for line in path.read_text(encoding='utf-8').splitlines():
        value=json.loads(line)
        if value.get('schema')!=1 or not value.get('event_id'):raise ValueError('corrupt Forge usage ledger')
        result.append(value)
