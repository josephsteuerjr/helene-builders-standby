        .init();

    info!("=== Starting Codex Proxy Server ==="); // Codex Proxy Server
    info!("Log directory: {}", logs_dir.display());
    info!("Timestamp: {}", chrono::Utc::now().to_rfc3339());

    // Display CLI menu
    loop {
        display_menu();
        let choice = get_user_choice();

        match choice.as_str() {
