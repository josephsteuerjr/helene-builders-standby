# --------- follow-up: где кончается моя память и начинается его почта
#
# Всё ниже читается из telegram_followups.py и раннера, а не пересказывается. Причина не
# в педантизме: пока писался этот рельс, механику переписывал сосед — и запись, обещающая
# «письмо уходит только по заказу» до того, как заказ появился в коде, была бы ровно той
# ложью, ради снятия которой рельс и заводится. Каждая половина спрашивает у кода, что
# сейчас правда, и обе ветки ответа написаны.
_FOLLOWUPS = "telegram_followups.py"
_FOLLOWUP_LOOSE_RE = re.compile(r"explicit_only\s*=\s*False")
_FOLLOWUP_ACTIONS_RE = re.compile(r'return "action должен быть ([^"]+)\."')


# Память по САМОМУ ТЕКСТУ, а не по mtime файла. Ключ — mtime был бы короче, но тесты
# подменяют `_source_text` лямбдой (так проверяются ветки «судью не зовёт никто» и «файл
# не прочитался»), и кэш по mtime отдал бы им настоящий agent.py — то есть проверка
# краснела бы не там, где неправда. Хэш строки питон запоминает в самом объекте, а
# сравнение `==` для одного и того же объекта коротит по идентичности, поэтому повторный
# вызов на кэшированном исходнике стоит ноль.
_CODE_ONLY_CACHE: dict[int, tuple[str, str]] = {}


def _code_only(text: str) -> str:
    """Исходник без строчных комментариев.

    Разница та же, что в сверке имён рычагов: `#` — записка тому, кто правит файл, и в ней
    цитата снятой строки («здесь стояло explicit_only=False») уместна и полезна. Если читать
    её как живой код, рельс объявит ей автоматизм, которого уже нет, — то есть соврёт ровно
    в момент починки. Наличие механики спрашиваем только у кода.

    15.08: появился кэш. Причина считанная, а не гигиеническая — эта функция чистит
    мегабайтный agent.py, и после того как сверка значений манифеста поехала в STATE
    каждого хода, она стала зваться десяток раз подряд на одном и том же тексте.
    """
    src = text or ""
    key = hash(src)
    hit = _CODE_ONLY_CACHE.get(key)
    if hit is not None and hit[0] == src:
        return hit[1]
    out = re.sub(r"(?m)#.*$", "", src)
    if len(_CODE_ONLY_CACHE) > 32:     # словарь без вытеснения: держим потолок, не LRU
        _CODE_ONLY_CACHE.clear()
    _CODE_ONLY_CACHE[key] = (src, out)
    return out


def _followup_ttl() -> tuple[float | None, str]:
    """(срок жизни следа, имя рычага). Имя рычага тоже читается: вписанное руками имя
    переживает переименование соседа молча — на этом уже обжигались дважды за день."""
    src = _code_only(_source_text(_FOLLOWUPS))
    # Не первое попавшееся имя: в этом файле уже есть PRAXIS_BASE, и он не имеет к сроку
    # никакого отношения — берём то, что действительно похоже на срок.
    env = next((n for n in re.findall(r"\bPRAXIS_[A-Z0-9_]+\b", src) if "TTL" in n), "")
    live = _live("telegram_followups", "TRACE_TTL_SEC")
    if isinstance(live, (int, float)) and not isinstance(live, bool):
        return float(live), env
    number = (_num_in(src, r"(?m)^TRACE_TTL_SEC = ([\d.]+)")
              or _num_in(src, r"def _trace_ttl\(\)[\s\S]*?return ([\d.]+)"))
    return number, env


def _num_in(text: str, pattern: str) -> float | None:
    """Число из уже прочитанного текста. Отдельно от `_from_source`, потому что здесь
    читается ОЧИЩЕННЫЙ от комментариев исходник: закомментированный старый кап не должен
    выдаваться за живой."""
    match = re.search(pattern, text)
    if not match:
        return None
    try:
        return float(match.group(1))
    except (TypeError, ValueError):
        return None


def _followup_report_gate() -> str:
    """Кто сегодня решает, что ответ на нить уедет владельцу письмом."""
    src = _code_only(_source_text(_FOLLOWUPS))
    runner = _code_only(_source_text(_RUNNER))
    if not src.strip() or not runner.strip():
        return "⚠ леджер нитей не прочитался — кому уходит письмо, отсюда не видно"
    if "notify_owner" in src:
        head = ("письмо уходит ТОЛЬКО по нити, где отчёт заказан (notify_owner); остальные "
                "нити — мой след и остаются у меня")
    else:
        head = ("⚠ письмо уходит по КАЖДОЙ отвеченной нити: признака «отчёт заказан» в леджере "
                "нет вовсе — след и почта владельцу здесь одно и то же")
    who = []
    if _FOLLOWUP_LOOSE_RE.search(runner):
        who.append("нить заводит ЛЮБАЯ последняя реплика владельца в его ЛС (explicit_only=False — "
                   "просьбы словами не требуется)")
    if "Praxis initiative from social pulse" in runner:
        who.append("и каждая моя реплика из часового пульса")
    if not who:
        who.append("нить с отчётом заводится на явную просьбу владельца словами (wants_followup)")
    return head + "; " + ", ".join(who)


def _followup_trace_life() -> str:
    ttl, env = _followup_ttl()
    ordered = ("; заказанный отчёт по возрасту не гаснет"
               if "notify_owner" in _code_only(_source_text(_FOLLOWUPS)) else "")
    if ttl is None:
        return ("срока жизни у следа нет: нить без ответа висит pending, пока я не отменю её "
                "сама — по возрасту гаснут только те, где срок назван словами в самой просьбе "
                "(explicit_expiry_seconds)")
    lever = f" ({env}, читается на импорте: смена требует рестарта)" if env else ""
    return f"след без ответа гаснет через {ttl / 3600:g}ч{lever}" + ordered


def _followup_caps() -> str:
    src = _code_only(_source_text(_FOLLOWUPS))
    runner = _code_only(_source_text(_RUNNER))
    # Кап ленты может жить и константой (её сосед вводит вместе с разделением), и дефолтом
    # сигнатуры context() — связывает тот, который есть, поэтому спрашиваем оба.
    lenta = (_neighbour_num("telegram_followups", "CONTEXT_LIMIT", _FOLLOWUPS,
                            r"(?m)^CONTEXT_LIMIT = (\d+)")
             or _num_in(src, r"def context\(self, \*, limit: int = (\d+)\)"))
    per_tick = _num_in(runner, r"for item in pending\[:(\d+)\]")
    keep = _num_in(src, r"(?m)^_SETTLED_KEEP = (\d+)")
    # 04.08: в строке ленты её собственный текст и чужая просьба разведены — «я сказала»
    # против «повод отправки». Рез у обоих один, и связывать надо тот, который в этой
    # строке главный: её слова. Пока он читался по ярлыку «повод», сверка держалась за
    # формулировку, которая называла её речь причиной.
    row = _num_in(src, r"я сказала: «\{said\[:(\d+)\]\}»")
    excerpt = _num_in(runner, r'response\.get\("text"\) or "\(без текста\)"\)\[:(\d+)\]')
    return (f"в ленте пульса не больше {_sec(lenta, ' нитей')} (остальные не показываются "
            f"вовсе), за тик не больше {_sec(per_tick, ' писем')}, история хранит "
            f"{_sec(keep, ' закрытых нитей')}; в строке ленты мои слова (и повод, если "
            f"слов нет) режутся до {_sec(row, ' симв')}, в письме ответ — до "
            f"{_sec(excerpt, ' симв')}")


def _followup_letter_face() -> str:
    src = _code_only(_source_text(_FOLLOWUPS))
    runner = _code_only(_source_text(_RUNNER))
    named = "sender_name" in src and "sender_name" in runner
    face = ("в письме назван человек, который ответил" if named else
            "⚠ в заголовке письма стоит метка ЧАТА, а не имя ответившего: имени леджер не "
            "хранит вовсе, только sender_id — «AbstractDL Chat ответил(а)» про человека")
    guarded = "sender_is_owner" in src or "notice_skipped" in src
    owner = ("ответ самого владельца нить закрывает, но письмом ему не возвращается" if guarded else
             "⚠ ответ самого владельца матчится как чужой: 27.07 02:32 его собственная реплика "
             "уехала ему же в ЛС")
    return "; ".join((face, owner, _followup_hand(runner)))


def _followup_tool_actions() -> list[str] | None:
    """Что по нитям принимает САМ тул telegram_account — то есть до чего дотягиваюсь я.

    Спрашивается именно тул, а не раннер: раннер — внутренняя кухня, и его список действий
    может уйти вперёд (27.07 так и было — `watch`/`unwatch` уже жили в раннере, когда в
    схеме тула их ещё не было). Назвать её рукой то, чего в схеме нет, значит выдать ей
    рычаг, который она нажмёт и не получит ничего.
    """
    live = _live("agent", "TELEGRAM_ACCOUNT_TOOL")
    names: list[str] = []
    if isinstance(live, dict):
        try:
            names = list(live["input_schema"]["properties"]["action"]["enum"])
        except Exception:
            names = []
    if not names:
        # Регулярка якорится на ИМЯ тула: в agent.py таких enum-блоков много, и первый
        # попавшийся принадлежит чужому инструменту — по нему рельс объявил бы, что рук
        # по нитям у меня нет вовсе.
        src = _code_only(_source_text("agent.py"))
        tool = re.search(r"TELEGRAM_ACCOUNT_TOOL = \{.*?\n\}", src, re.S)
        block = re.search(r'"action": \{"type": "string", "enum": \[(.*?)\]\}',
                          tool.group(0) if tool else "", re.S)
        if not block:
            return None
        names = re.findall(r'"([a-z_]+)"', block.group(1))
    return [n for n in names if "followup" in n or "watch" in n]


def _followup_hand(runner: str) -> str:
    mine = _followup_tool_actions()
    inner = _FOLLOWUP_ACTIONS_RE.search(runner)
    inner_actions = inner.group(1) if inner else ""
    if mine is None:
        return "какие действия по нитям принимает telegram_account, из кода не прочиталось"
    if not mine:
        hand = "⚠ по нитям тул не принимает ни одного действия — леджер живёт мимо моих рук"
    else:
        hand = "мои действия над нитью: " + ", ".join(mine)
        if not any("watch" in n for n in mine):
            hand += " — то есть погасить нить могу, а завести отчёт или снять его нет"
    if not any("watch" in n for n in mine) and "watch" in inner_actions:
        hand += ("; ⚠ раннер такую команду уже принимает (" + inner_actions.strip()
                 + "), но в схеме тула её нет — до меня рычаг ещё не доведён")
    return hand


def _followup_notice_value() -> str:
    return "; ".join(x for x in (_followup_report_gate(), _followup_trace_life(),
                                 _followup_caps(), _followup_letter_face()) if x)


_BROKER = "serverd/broker.py"


def _budget_ceiling(conn: float | None) -> float | None:
    """Потолок её собственного `budget_seconds`. Дефолт объявлен НЕ литералом, а именем
    соседней константы (`CONNECTION_TIMEOUT_SEC`) — подставить сюда своё число значило бы
    развязать их молча: разъедутся при первой же правке соседа."""
    match = re.search(r"WORKSPACE_BUDGET_MAX_SEC = _env_number\(\s*\"[^\"]*\",\s*([\w.]+)",
                      _source_text(_BROKER))
    if not match:
        return None
    raw = match.group(1)
    if raw == "CONNECTION_TIMEOUT_SEC":
        return conn
    try:
        return float(raw)
    except ValueError:
        return None


# ⚠ 27.07. Кап поиска по хосту НЕ равен бюджету обхода и рычага не имеет: обход рвётся на
# SEARCH_FILE_CAP прочитанных файлов, а приписку к оборванному поиску писал чужой кошелёк
# (Budget.note) — он называл ДРУГОЕ число и советовал PRAXIS_FORGE_SCAN_FILES, рычаг, на
# search не влияющий. Владелец brokerops правит это в той же волне, поэтому «объясняет ли
# демон свой кап сам» здесь не утверждается, а ПРОВЕРЯЕТСЯ по его коду: перестанет —
# рельс останется единственным местом, где записана правда, и скажет об этом вслух.
_SEARCH_OWN_NOTE_RE = re.compile(r'f"[^"]*\{SEARCH_FILE_CAP\}')


def _search_caps_note() -> str:
    src = _source_text(_BROKEROPS)
    files = _from_source(_BROKEROPS, r"(?m)^SEARCH_FILE_CAP = (\d+)")
    hits = (_from_source(_BROKEROPS, r"(?m)^SEARCH_HIT_CAP = (\d+)")
            or _from_source(_BROKEROPS, r"if len\(hits\) >= (\d+):"))
    if files is None:
        return "Кап поиска по хосту не прочитался — сколько файлов он успевает, я не знаю."
    note = (f"Поиск (search) рвётся на {files} ПРОЧИТАННЫХ файлах (SEARCH_FILE_CAP) или на "
            f"{_num(hits)} находках, и env-рычага у этих двух нет — они литералы в "
            f"serverd/brokerops.py; PRAXIS_FORGE_SCAN_FILES их не двигает, помогает только "
            f"сужение path/glob.")
    if _SEARCH_OWN_NOTE_RE.search(src):
        return note
    return note + (" ⚠ Сам демон этот кап по имени не называет: приписку к оборванному поиску "
                   "пишет кошелёк ОБХОДА (Budget.note) — там будет чужое число и совет про "
                   "PRAXIS_FORGE_SCAN_FILES. Верное число — здесь.")


def _serverd_workspace_value() -> str:
    """Бюджет счёта на СТОРОНЕ демона. Читается из репозитория, а не спрашивается у демона:
    рельс собирается на пути её ответа, и лишний RPC здесь стоит секунд её же времени.
    Живой демон ставится из этих самых файлов (serverd/install.sh), но если выкатили только
    контейнер — числа разойдутся, и это названо прямо."""
    budget = _from_source(_BROKER, _decl("WORKSPACE_BUDGET_SEC", "_env_number"), float)
    wait = _from_source(_BROKER, _decl("WORKSPACE_WAIT_SEC", "_env_number"), float)
    slots = _from_source(_BROKER, r"min\((\d+), \(os\.cpu_count\(\) or \d+\) - 1\)", int)
    heavy = re.search(r"HEAVY_INSPECT_ACTIONS = \{([^}]*)\}", _source_text(_BROKER))
    actions = (", ".join(x.strip().strip('"\'') for x in heavy.group(1).split(",") if x.strip())
               if heavy else "не прочиталось")
    conn = _from_source(_BROKER, _decl("CONNECTION_TIMEOUT_SEC", "_env_number"), float)
    ceiling = _budget_ceiling(conn)
    return (f"демон считает мой тяжёлый inspect не дольше {_sec(budget)} и отдаёт ЧАСТИЧНЫЙ "
            f"ответ с признаком усечения, а не молчание; одновременно тяжёлых чтений по "
            f"умолчанию min({_sec(slots, '')}, ядра−1) на машине демона, очередь за "
            f"слотом {_sec(wait)} — это очередь, а не отказ. Тяжёлыми считаются: {actions}. "
            f"Соединение с демоном он держит {_sec(conn)} "
            f"(PRAXIS_SERVERD_CONNECTION_TIMEOUT_SEC), и столько же — потолок МОЕГО "
            f"собственного budget_seconds: {_sec(ceiling)} "
            f"(PRAXIS_SERVERD_WORKSPACE_BUDGET_MAX_SEC); считать дольше, чем живёт канал, "
            f"некому. {_search_caps_note()} "
            f"Числа — из репозитория; демон ставится из него же, но если выкачен только "
            f"контейнер, живой демон может быть старше")


# Имя рычага здесь НЕ вписано руками, и это не педантизм: пока писалась эта запись, владелец
# forge_verify.py переименовал порог (PRAXIS_VERIFY_HOST_DEADLINE_SEC → PRAXIS_VERIFY_TIMEOUT_SEC)
# и сменил значение втрое — ровно то, что случилось с PRAXIS_FORGE_LOCK_ABANDONED_SEC, только
# на моих глазах. Поэтому и константа, и её env читаются одной регуляркой из объявления.
_VERIFY_DEADLINE_RE = re.compile(
    r"(\w*DEADLINE_SEC) = int\(float\(os\.getenv\(\"([A-Z_]+)\"\)\s*or\s*(\d+)\)\)")


# Предел, который связывает, живёт литералом в СИГНАТУРЕ тула, а не в константе модуля.
# Такой не ловится ни поиском по PRAXIS_*, ни описью верхнего уровня — verification_deadline
# нашёлся случайно. У поднятого модуля спрашиваем живую сигнатуру (её можно подменить, и
# рельс обязан поехать за подменой), иначе читаем объявление.
def _tool_signature_default(module: str, func: str, param: str, rel: str) -> int | None:
    live = _live(module, func)
    if live is not None:
        try:
            import inspect as _inspect
            value = _inspect.signature(live).parameters[param].default
            if isinstance(value, (int, float)) and not isinstance(value, bool):
                return int(value)
        except Exception:
            pass
    return _from_source(rel, rf"def {re.escape(func)}\([^)]*?{re.escape(param)}: int = (\d+)")


# Живёт ли env-порог только на `or`, то есть достаётся ли он лишь при явном timeout=0.
_VERIFY_ENV_ON_ZERO_RE = re.compile(r'request\.get\("timeout"\)\s*or\s*\w*DEADLINE_SEC')


def _verification_deadline_value() -> str:
    src = _source_text("forge_verify.py")
    match = _VERIFY_DEADLINE_RE.search(src)
    tool = _tool_signature_default("agent", "tool_coding_verify", "timeout", "agent.py")
    if not match:
        return ("⚠ срок матрицы проверок в forge_verify.py не прочитался — значит я не знаю, "
                "сколько живёт проверка без своего срока")
    name, env, sec = match.group(1), match.group(2), int(match.group(3))
    tail = ("; срок уезжает ОБЕИМ сторонам, чтобы демон останавливал команду сам, а не догорал "
            "после смерти клиента. Он законно длиннее потолка руки: матрица живёт в отдельном "
            "процессе, потолок хода до неё не достаёт")
    if not _VERIFY_ENV_ON_ZERO_RE.search(src):
        # Сосед переписал разбор: env снова может оказаться действующим источником.
        return (f"проверка, пришедшая без своего срока, получает {sec}с ({name}, рычаг {env}); "
                f"дефолт моей руки coding_verify(timeout={_num(tool)})" + tail)
    if tool is None:
        return (f"⚠ дефолт coding_verify(timeout=…) не прочитался, а связывает именно он: "
                f"{name}={sec}с (рычаг {env}) в живом пути НЕ действует — forge.verify всегда "
                f"кладёт число в запрос, и env достаётся только при timeout=0" + tail)
    return (f"проверке без своего срока даётся {tool}с — и это ДЕФОЛТ СИГНАТУРЫ моей руки "
            f"coding_verify(timeout={tool}), а не переменная окружения: forge.verify кладёт это "
            f"число в запрос всегда. {name}={sec}с (рычаг {env}) стоит за `or` и достаётся "
            f"ТОЛЬКО когда я сама зову coding_verify(timeout=0) — в обычном ходе {env} не "
            f"действует, и поставить его в .deploy.env значит ничего не изменить. Настоящий "
            f"рычаг на каждый вызов — мой собственный аргумент timeout" + tail)


