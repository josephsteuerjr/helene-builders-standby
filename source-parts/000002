            wake = _wake(mid=40, ts=990.0, context='answer')
            wakes = {'-704': wake}
            client = _Client()
            async def interrupted(*args, **kwargs):
                self.assertEqual(spool.pending()[0].queue_id, item.queue_id)
                raise asyncio.CancelledError
