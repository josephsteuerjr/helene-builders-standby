                MENU_OPEN => supervisor.open_state(),
                MENU_RECONNECT => supervisor.request_reconnect(),
                MENU_EXIT => {
                    supervisor.stop();
                    unsafe { PostQuitMessage(0) };
                }
                _ => {}
            }
        }
    }

