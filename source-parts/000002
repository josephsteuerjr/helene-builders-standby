class SilenceContourTests(unittest.TestCase):
    def setUp(self):
        self.journal: list[str] = []
        patcher = mock.patch.object(
            agent, "tool_journal",
            side_effect=lambda text, **kw: self.journal.append(text))
        patcher.start()
        self.addCleanup(patcher.stop)
