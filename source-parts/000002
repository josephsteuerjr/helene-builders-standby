    """Последние страховочные снапшоты: «ref sha» (для глаз/восстановления)."""
    if not repo_ready():
        return []
    try:
        r = _git("for-each-ref", "--format=%(refname:short) %(objectname:short)",
                 "--sort=-refname", SNAPSHOT_REF_NS + "/")
