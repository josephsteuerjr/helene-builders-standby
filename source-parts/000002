    """Поставить рычаг (живо, без рестарта). by: praxis | the owner — источник честно виден."""
    if knob not in KNOBS:
        return {"ok": False, "error": frame_language.text('helper.perception.set_knob.180', p0=f'{knob}', p1=f"{', '.join(KNOBS)}")}
