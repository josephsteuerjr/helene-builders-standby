        self.assertNotIn("STATUS_FIRST", text)
        self.assertNotIn("TARGET_FIRST", text)
        self.assertNotIn("STATUS_SECOND", stable)
        self.assertIn("STATUS_SECOND\n[reply] TARGET_SECOND", tail)

