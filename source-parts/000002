               if alive and (c.get("cpu_pct") or c.get("mem_used")) else "")
        lvl = c.get("level") or ""
        risk = " ⚠ доступ к докеру/хосту" if lvl == "host" else (" · изоляция ослаблена" if lvl == "loose" else "")
        out.append(f"  {mark} {c.get('name', '?'):<20} {c.get('status') or c.get('state') or '?'}"
