        self._seed_room("-3002", last_ts=stale_ts,
                        verified="2026-10-04 подтверждено лентой")    # сверена вчера
        self._seed_room("-3003", last_ts=time.time())                 # живая лента
        out = self._run()
        places = {r.get("place"): r for r in out if r.get("kind") == "room"}
        self.assertIn("-3001", places, "тихая несверенная комната обязана быть кандидатом")
