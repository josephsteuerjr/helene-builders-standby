        excerpt = str(item.get("sent_excerpt") or "")[:80]
        line = f"{label} (follow-up, без ответа): {excerpt}"
        if line not in seen:
            seen.add(line)
            lines.append(line)

    return tuple(lines[:MAX_ITEMS])
