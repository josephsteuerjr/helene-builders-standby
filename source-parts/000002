    for row in pub:
        who = row.get("comm") or "?"
        tgt = f" → {row['target']}" if row.get("target") else ""
        out.append(f"  {row.get('port')}/{row.get('proto')} · {who}{tgt}")
    if p.get("local_only"):
        out.append(f"  + {p['local_only']} сокет(ов) только на loopback (наружу не торчат)")
