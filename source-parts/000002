        import sqlite3
        # `with connect(...)` закрывает ТРАНЗАКЦИЮ, а не соединение; незакрытый
        # хэндл держал файл, и на Windows атомарная подмена базы внутри search
        # падала WinError 5 (POSIX прощает replace под открытым — винда нет).
        with contextlib.closing(sqlite3.connect(db)) as con:
