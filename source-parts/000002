                 issuance.namespace == obj['issuance']['namespace'] and
                 issuance.authority_sha256 == obj['issuance']['authority_sha256'] and
                 issuance.authority_revision == obj['issuance']['authority_revision'],
                 'runtime issuance binding changed')
