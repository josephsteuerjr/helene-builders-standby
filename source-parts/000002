        return False
    nm, body = read(slug)
    nm = nm or name
    key = (dst_slug, (label or "").strip().lower())
    for d, lab in links(slug):
        if (d, lab.lower()) == key:
            return False
    line = f"- [[{dst_slug}]]" + (f" — {label.strip()}" if (label or "").strip() else "") + f" _({_today()})_"
    cur = body.get(LINKS, "")
    body[LINKS] = (cur + "\n" + line).strip() if cur else line
