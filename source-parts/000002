def _hosted_web_search_tool() -> dict | None:
    backend = llm.web_search_backend()
    if backend == "anthropic":
        return WEB_SEARCH_TOOL
    if backend == "openai":
        return OPENAI_WEB_SEARCH_TOOL
    return None

