    }

    impl Supervisor {
        fn new(body: PathBuf, config: PathBuf, state_dir: PathBuf, mode: ChildMode) -> Arc<Self> {
            Arc::new(Self {
                body,
                config,
                state_dir,
                mode,
                stopping: AtomicBool::new(false),
                reconnect: AtomicBool::new(false),
                child: Mutex::new(None),
