    try:
        import authored_notes
        notes = authored_notes.AuthoredNoteLedger(base).list(
            status="open", kind="question", limit=10)
    except Exception:
        return [], False
    rows: list[tuple[str, str, str]] = []
    for note in notes:
        date = str(note.get("created_at") or "")[:10] or "без даты"
