                  'sys.stdout.buffer.write(sys.stdin.buffer.read());'
                  'sys.stderr.write(os.environ["HELENE_ADMISSION_FIXTURE"]);'
                  f'Path({str(marker)!r}).write_text("executed")')
            args=[sys.executable,'-B','-c',code]
