            let object = step.as_object_mut().unwrap();
            for (key, value) in extra.as_object().unwrap() {
                object.insert(key.clone(), value.clone());
            }
            step
        };
        // Второй шаг заведомо непроходим, поэтому «принято» видно по тому, КАКАЯ
