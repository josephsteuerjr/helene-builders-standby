        lines.append(f"{label}: {expectation[:600]}")
    if action_label:
        lines.append(f"Действие: {action_label}")
    rendered = "\n".join(lines)
    return rendered if len(rendered) <= 3900 else rendered[:3897].rstrip() + "…"


