        found.append("commercial_offer")
    if re.search(r"(?:пиши(?:те)?|напиши(?:те)?|став(?:ь|ьте)|жми(?:те)?|перейди(?:те)?|найди(?:те)?|ищи(?:те)?|в личк|в лс|остав(?:ь|ьте).{0,12}(?:\+|плюс)|отклик)", value):
        found.append("call_to_action")
