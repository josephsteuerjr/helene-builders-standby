            for name, cached in list(llm._CLIENTS.items()):
                fw = (config.get('frameworks') or {}).get(name) or {}
                if cached[0] != (fw.get('base_url') or '', fw.get('api_key') or ''):
                    llm._CLIENTS.pop(name, None)
