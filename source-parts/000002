from self_model import FileLock, utc_now


SCHEMA = "praxis.authored_note.event.v1"
KINDS = frozenset({"scratch", "note", "reflection", "question"})
SCOPES = frozenset({"global", "chat", "run"})
STATUSES = frozenset({"open", "closed"})
