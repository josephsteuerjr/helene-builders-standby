            f"доказательство, что молчаливых путей не осталось)")


_SCHEDULE_HOLD_RE = re.compile(r"appetite\.background_hold")


def _schedule_hold_effect() -> str:
    """Что пауза фона делает с рекуррентным вхождением — читается из раннера.

    Различие не косметическое. Сон и «она одна» ОТКЛАДЫВАЮТ: намеченное остаётся due и
    вернётся. Пауза фона на recur-вхождении зовёт `_consume()` — вхождение потребляется,
    расписание сдвигается на следующее, и этого конкретного раза не будет. Написать здесь
    «отложено» значило бы соврать ровно тем способом, которым манифест уже врал: обещать
    ей возврат намерения, которого не будет.
    """
    src = _code_only(_source_text("mtproto_runner.py"))
    if not src.strip():
        return "⚠ раннер не прочитался — что пауза фона делает с расписанием, отсюда не видно"
    match = _SCHEDULE_HOLD_RE.search(src)
    if not match:
        return ("паузы фона на расписании в раннере сейчас НЕТ — третьего вето не существует, "
                "и текст рельса выше отстал")
    lines = src[:match.start()].count("\n")
    block = "\n".join(src.splitlines()[lines:lines + 25])
    consumed = "_consume()" in block
    seen = "note_skip" in block
    return ("пауза фона на рекуррентном вхождении: "
            + ("вхождение ПОТРЕБЛЯЕТСЯ (расписание сдвигается на следующее — этого раза не "
               "будет, он не вернётся)" if consumed
               else "вхождение сохраняется — вернётся следующим сроком")
            + ("; видно в manage_perception(\"skips\")" if seen
               else "; в perception_skips это НЕ пишется — только в логе раннера, а лога у "
                    "меня нет"))


