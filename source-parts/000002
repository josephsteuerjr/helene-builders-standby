# Кадр — документ, который она читает глазами. Эти рычаги меняют ЕГО ФОРМУ, а не
# содержание, и оба читаются на импорте agent.py: смена требует перезапуска РАННЕРА
# (memory/.control/restart_request.txt), а не `docker restart`.
# PRAXIS_FRAME_FORM=new            # new (умолчание) — правило-заголовок, подпись сборщика
#                                  # «↳ причина · путь · как отобрано», тело настоящими
#                                  # переносами под гуттером, пятая зона <CURRENT_SITUATION>
#                                  # и подписанный тег текущей реплики.
#                                  # old — ВЧЕРАШНИЙ кадр байт-в-байт: json.dumps-тиры, ни
#                                  # зоны, ни гуттера, ни метра. Это рычаг ОТКАТА, а не
#                                  # оформление: под ним новая машинерия не исполняется вовсе.
