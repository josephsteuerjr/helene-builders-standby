def unacked_request() -> dict | None:
    """Просьба владельца, которую я ещё не истолковала (новее моего толкования)."""
    s = _load()
    req = s.get("owner_request")
    if not req:
        return None
    interp = s.get("interpretation") or {}
    if float(req.get("ts", 0)) > float(interp.get("ts", 0) or 0):
        return req
    return None


