def mode() -> str:
    """off | on | dm. `dm` — тень только в личках: первый полигон, где живёт v3."""
    raw = (os.getenv("PRAXIS_FRAME_SHADOW") or "").strip().lower()
    if raw in ("1", "true", "yes", "on"):
        return "on"
    if raw == "dm":
        return "dm"
    return "off"


def enabled() -> bool:
    return mode() != "off"


