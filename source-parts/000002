def worker(generation, run_id):
    # Reserve protocol stdout before importing anything with diagnostics.
    output = os.fdopen(os.dup(1), 'wb', buffering=0)
    with open(os.devnull, 'wb') as sink:os.dup2(sink.fileno(), 1)
