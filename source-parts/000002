    настоящим содержанием слова «дёшево», и оно держится тестом
    `test_values_are_read_only_for_the_named_rails`.

    Цена не абстрактная: эта функция стоит на пути `capabilities.state_line()`, то есть
    в STATE КАЖДОГО хода. Резать её `_judge_cap_announced`-ом в один проход намеренно не
    стали — это ровно то место, где рельс однажды уже нашёл кап судьи в комментарии.
    """
    try:
        drift = manifest_drift()
    except Exception:
        return "состояние неизвестно"
    if not drift.get("file"):
        return "⚠ файла нет" if brief else "файла ещё нет (пишет ночное обслуживание)"

    def _few(ids: list[str], n: int = 4) -> str:
        # Строка едет в STATE каждого хода: называем сколько и кого именно, но не
        # вываливаем весь список — за полным есть registry() и manifest_drift().
        head = ", ".join(ids[:n])
        return head + (f" и ещё {len(ids) - n}" if len(ids) > n else "")

    unchecked = list(drift.get("unchecked") or ())
    if drift.get("ok"):
        # ⚠ «Не смогла проверить» и «совпало» обязаны звучать по-разному. Если свидетель
        # не посчитался (исходник не прочитался, соседа нет в процессе), сказать «свеж»
        # значило бы выдать молчание прибора за факт о файле — ровно та ошибка, ради
        # которой сверка значений и заводилась.
        if not unchecked:
            # Полная форма едет в my_capabilities: там я спрашиваю специально и хочу имена
            # — в том числе имя границы. «Сверено» без списка читалось бы как «сверено
            # всё», а сверено далеко не всё.
            return ("свеж" if brief else
                    "совпадает с кодом; значение сверено у "
                    + _few(sorted(VALUE_WITNESSES))
                    + " — у остальных рельсов строка «сейчас» не проверялась вовсе")
        return (f"свеж, не проверено значений: {len(unchecked)}" if brief else
                "совпадает с кодом по составу, но значение не проверялось у "
                + _few(unchecked) + " — свидетель не посчитался, это «не знаю»")
    if brief:
        gap = len(drift["missing"]) + len(drift["stale"]) + len(drift.get("value_stale") or ())
        return f"⚠ отстал на {gap}"

    bits = []
    if drift["missing"]:
        bits.append(f"нет в файле {len(drift['missing'])}: {_few(drift['missing'])}")
    if drift["stale"]:
        bits.append(f"обещает несуществующее: {_few(drift['stale'])}")
    if drift.get("value_stale"):
        bits.append(f"значение врёт у {len(drift['value_stale'])}: "
                    f"{_few(list(drift['value_stale']))}")
    if unchecked:
        bits.append(f"значение не проверялось у {_few(unchecked)}")
    return "ОТСТАЛ (" + "; ".join(bits) + ") — правда в registry(), не в файле"
