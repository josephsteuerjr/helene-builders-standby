           message: str, files: list[str] | None = None) -> dict:
    kind = str(kind or "finding").strip().lower()
    if kind not in KINDS:
        raise ValueError("kind: " + " | ".join(sorted(KINDS)))
    row = {"at": _now(), "node_id": _node_id(node_id), "agent_id": str(agent_id or ""),
