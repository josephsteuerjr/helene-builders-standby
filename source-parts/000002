    def _say(self, context, action: str, **fields) -> dict:
        """Её слово ЖИВОЙ рукой: через потолок времени, в отдельном потоке.

        Прямой вызов `work_loop.claim()` здесь был бы ровно тем вакуумом, из-за которого
