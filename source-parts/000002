    let script = std::env::var_os("HELENE_CU_PYTHON_SCRIPT")
        .map(PathBuf::from)
        .context("Python CU script not selected")?;
    run(
        &python,
        &script,
        capability,
        args,
        Duration::from_secs(20),
        MAX_READ_REQUEST,
