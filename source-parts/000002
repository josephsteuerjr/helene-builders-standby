    # outcomes and reconcile partial custody through Stop, never execute again.
    import forge_verify_remote
    owner_path=directory.parent.parent/'task.json'
    if directory.parent.name=='verifications':
        owner=forge_verify_remote._read(owner_path)
        expected=str(owner.get('scope') or 'self')
        if (not owner or owner.get('id') not in (None,directory.parent.parent.name)
                or request.get('task_id') not in (None,directory.parent.parent.name)
                or request.get('id') not in (None,directory.name)
                or (request.get('scope') and request['scope']!=expected)
                or request.get('root')!=owner.get('root')
                or request.get('verification_custody')!='check-tree-v1'):
            _write(directory/'stop.json',{'state':'unresolved','note':'matrix bootstrap authority/legacy admission unproven; no checks replayed','at':_now()})
            return 2
        scope=expected
    result_path=directory/'result.json'
    if result_path.exists():
        status=forge_verify_remote.result_status(request,forge_verify_remote._read(result_path),scope=scope)
        return 0 if status in {'passed','passed_with_skips','done'} else (2 if status not in forge_verify_remote.MATRIX_TERMINAL else 1)
    if (directory/'state.json').exists():
        _write(directory/'stop.json',{'state':'unresolved','note':'matrix execution already observed; exact check custody requires reconciliation, no replay','at':_now()})
        return 2
