  # Нужно только при PRAXIS_EMBEDDINGS=1. По умолчанию память работает без него.
  ollama:
    profiles: ["ollama"]
    image: ollama/ollama
    container_name: praxis-ollama
    volumes:
      - ollama_models:/root/.ollama
    restart: unless-stopped

volumes:
  relay_auth:
  relay_logs:
  ollama_models:
