            .arg("invoke-envelope")
            .arg("--config")
            .arg(&config.body_config)
            .stdin(Stdio::piped())
            .stdout(Stdio::piped())
            .stderr(Stdio::piped())
            .kill_on_drop(true);
        command.as_std_mut().creation_flags(CREATE_NO_WINDOW.0);
        let mut child = command.spawn().context("start SYSTEM body helper")?;
