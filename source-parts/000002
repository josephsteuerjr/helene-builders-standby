def tool_parts():
    tree = ast.parse(Path(__file__).with_name('agent.py').read_text(encoding='utf-8'))
    handler = next(n for n in tree.body if isinstance(n, ast.FunctionDef)
                   and n.name == 'tool_switch_brain')
