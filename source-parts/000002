_MODEL_IMAGE_MIME = {"image/jpeg", "image/png", "image/webp", "image/gif"}


def _media_prompt(convo_text: str, media_refs: tuple[media.MediaRef, ...],
                  ctx: "ChannelContext",
                  model_text: str | None = None,
                  unavailable_refs: list | None = None) -> tuple[str, str | list[dict]]:
    """Проверить вложения, расшифровать аудио и собрать канонический multimodal user content.

    Возвращает ДВА разных текста, и это намеренно:
      * первый — для расписок, прожитого хода и исходящей границы: весь разговор целиком;
      * второй — то, что уезжает модели пользовательским сообщением.
    Пока роли не были разведены, это был один и тот же текст. Когда её собственные реплики
    едут ролью `assistant`, класть тот же разговор ещё и в user-сообщение значило бы
    показать его дважды. Расшифровка аудио при этом снимается ОДИН раз и приклеивается к
    обоим: платить за STT дважды нельзя, а терять расшифровку в расписке — тем более."""
    spool = _media_spool()
    refs = tuple(media_refs or ())
    selected_start = max(0, len(refs) - spool.max_turn_media)
    photos: list[dict] = []
    additions: list[str] = []
    audio_n = photo_n = 0
    for index, ref in enumerate(refs):
        try:
            spool.validate_ref(ref, expected_scope=ctx.scope, expected_chat_id=ctx.chat_id)
        except media.MediaMissingError:
            # Missing bytes are not evidence of what the attachment contained.
            # Binding checks above must succeed even for this text-only fallback.
            additions.append(
                f"[Вложение #{index + 1} ({ref.kind}) недоступно: локальный файл "
                "отсутствует; содержимое не просмотрено и не восстановлено.]")
            if unavailable_refs is not None:
                unavailable_refs.append(ref)
            continue
        if index < selected_start:
            continue
        if ref.kind == "photo":
            photo_n += 1
            if ref.mime not in _MODEL_IMAGE_MIME:
                additions.append(f"[Изображение #{photo_n}: формат {ref.mime} пока не читается моделью]")
                continue
            photos.append({"type": "image", "path": str(ref.path), "mime": ref.mime,
                           # На GPT-5.6 auto сохраняет исходный размер; старшие 5.x тоже принимают auto.
                           "detail": "auto"})
        elif ref.kind == "audio":
            audio_n += 1
            try:
                transcript = media_audio.transcribe(ref.path).strip()
            except media_audio.AudioBackendError:
                log.warning("аудио #%d не расшифровано [%s]", audio_n, ctx.chat_id, exc_info=True)
                transcript = ""
            except Exception:
                log.warning("неожиданный сбой STT #%d [%s]", audio_n, ctx.chat_id, exc_info=True)
                transcript = ""
            additions.append(
                f"[Аудио #{audio_n}, расшифровка]: {transcript}"
                if transcript else f"[Аудио #{audio_n}: речь не распознана]")
    def _with_additions(text: str) -> str:
        selected_epoch = frame_epoch.applies(ctx) and frame_epoch.bound_tape(ctx.chat_id) is not None
        base = (text or "") if selected_epoch else (text or "").strip()
        if not additions:
            return base
        combined = base + "\n\n" + "\n".join(additions) if base else "\n".join(additions)
        return combined if selected_epoch else combined.strip()

    augmented = _with_additions(convo_text)
    for_model = augmented if model_text is None else _with_additions(model_text)
    if not photos:
        return augmented, for_model
    return augmented, [{"type": "text", "text": for_model}, *photos]


def _drop_outbound(items: list[media.OutboundMedia]) -> None:
    """Удалить только созданные этим непропущенным ходом копии из outbound spool."""
    for item in items:
        try:
            _media_spool().validate_outbound(item)
            item.path.unlink(missing_ok=True)
        except Exception:
            log.debug("не смогла убрать непропущенное медиа", exc_info=True)


