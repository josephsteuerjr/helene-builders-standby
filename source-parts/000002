def _unquoted_text(text: str) -> str:
    """Заменить содержимое обычных цитат пробелами, сохранив смещения."""
    chars = list(text)
    stack: list[str] = []
    for index, char in enumerate(text):
        if stack:
            chars[index] = " "
            if char == stack[-1]:
                stack.pop()
            continue
        closing = _QUOTE_PAIRS.get(char)
        if closing:
            chars[index] = " "
            stack.append(closing)
    return "".join(chars)


