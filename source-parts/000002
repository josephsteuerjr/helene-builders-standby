class EndpointPolicy(unittest.TestCase):
    def setUp(self):
        self.cfg = llm._normalize({'frameworks': {
            'embedded': {'protocol': 'openai', 'provider': 'relay', 'api_mode': 'chat_completions',
                         'base_url': 'http://127.0.0.1:5012/v1', 'api_key': 'synthetic-test-only'},
