    def _seed_room(self, place: str, *, last_ts: float, verified: str = "") -> None:
        ml.STATE_DIR.mkdir(parents=True, exist_ok=True)
        state = {"chat_id": place, "updated_at": "2026-10-05T00:00:00Z",
                 "hot": [{"id": f"{place}-1", "ts": last_ts, "line": "x",
                          "actor": "a", "direction": "in", "salience": 2,
