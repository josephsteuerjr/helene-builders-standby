        return {"ok": False, "error": frame_language.text('helper.perception.reset_knob.209', p0=f'{knob}')}
    st = dict(_state())
    ov = dict(st.get("overrides") or {})
    if knob not in ov:
        return {"ok": False, "error": frame_language.text('helper.perception.reset_knob.213', p0=f'{knob}')}
    old = value(knob)
