CONTEXT_HOT_MAX = 1000
CONTEXT_SUMMARY_MAX = 80_000
BACKFILL_MAX = 5_000
HEADER_KEYS = ("mode", "mode_reason", "mode_until", "mode_set_by",
               # 05.10, ночной цикл: служебная строка свежести места — когда профиль
