            tokio::select! {
                result = server.connect() => {
                    result?;
                    let next = config.clone();
                    tokio::spawn(async move {
                        if let Err(error) = connection(server, next.clone()).await {
                            log(&next.log, &format!("SYSTEM request failed: {error:#}"));
                        }
                    });
                }
                _ = stop_requested() => break,
            }
        }
        Ok(())
    }

