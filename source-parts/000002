        input.extend_from_slice("да".as_bytes());
        let out = decode_stream_chunk(&input, &mut carry);
        assert_eq!(out, "ok\u{FFFD}да");
        assert!(carry.is_empty(), "broken bytes must not stall the stream");
    }

