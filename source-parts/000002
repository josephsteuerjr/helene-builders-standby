    query, glob = request['query'], request['glob']
    rg = request.get('rg')
    if rg:
        cmd = [rg, '--line-number', '--no-heading', '--color', 'never', '-g', glob or '**/*',
               '--', query, str(p if p.is_dir() else p.parent)]
        try:
