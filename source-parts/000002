    def test_lifted_filter_drops_a_private_markdown_items_continuation(self):
        (self.base / "memory" / "people" / "гость.md").write_text(
            "# Гость\ntelegram_id: 202\n"
            "- [private] закрытый пункт\n"
            "  ПРОДОЛЖЕНИЕ ТАЙНЫ\n"
            "  - ВЛОЖЕННАЯ ТАЙНА\n"
            "- открытый пункт\n",
            encoding="utf-8")
        _, src = frame_shadow._lifted_source(
