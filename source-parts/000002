        );
        assert!(
            refused(drag(serde_json::json!({"step_delay_ms": 5_001})))
                .contains("drag step_delay_ms is 5001ms")
        );

        // Сумма внутренних пауз упирается в общий бюджет: 200x150 = 30000 проходит,
        // 201-я миллисекунда на шаге — уже нет.
