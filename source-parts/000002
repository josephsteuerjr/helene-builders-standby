        self.patch = patch
        patch(identity, BASE=self.tmp, SOUL_DIR=soul, ARCHIVE_DIR=soul / "archive",
              STATE_DIR=mem / ".state" / "identity",
              STATE_PATH=mem / ".state" / "identity" / "state.json",
