_SKIP_PREFIXES = (sys.prefix, sys.base_prefix, "/proc/", "/sys/", "/dev/", "/usr/lib/", "/usr/local/lib/", "/etc/ssl/")
_SKIP_SUFFIXES = (".py", ".pyc", ".so", ".pyi")
