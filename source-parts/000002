                "note": blind.strip(),
                "text": (f"{blind}Сохранила ({message}), но номер коммита прочитать не вышло: "
                         f"{sha[:300]}. Работа зафиксирована, откатываться по номеру нечем — "
                         f"смотри `git log -1` в {git}.")}
