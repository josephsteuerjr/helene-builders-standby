log = logging.getLogger("praxis-git")

BASE = Path(os.environ.get("PRAXIS_BASE") or Path(__file__).resolve().parent)
TIMEOUT = 30
SNAPSHOT_REF_NS = "refs/praxis-snapshots"
SNAPSHOT_KEEP = 40


def _git(*args: str):
