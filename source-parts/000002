            self.choose('fr')
            await asyncio.sleep(0)
            raise asyncio.CancelledError()
        async def run():
            with self.assertRaises(asyncio.CancelledError):await produce()
            self.assertEqual(fl.language(),'fr')
        asyncio.run(run())
