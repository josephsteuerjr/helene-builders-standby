                      "evaluator": {"framework": "openai", "model": "gpt-5.6-terra",
                                    "fallback_model": "gpt-5.5",
                                    "fallback_framework": "openai", "max_tokens": 400}},
            "limits": {}})
        llm.save_config(cfg)
