            "# Двойной\ntelegram_id: 987654321\ntelegram_id: 111222333\n"
            "- [private] ТАЙНА-ДВОЙНОГО\n", encoding="utf-8")
        (ppl / "легаси.md").write_text("# Легаси\nпишет с 987654321\n",
                                       encoding="utf-8")
        self.assertIsNone(frame_shadow._dossier_for("987654321"))

