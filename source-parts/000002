# Что заголовок обязан пережить: скобочный хвост ярлыка. `(?s)` — хвост бывает многострочным.
_REMARK_RE = re.compile(r"^(.*?)\s*\((.*)\)\s*$", re.S)

_SNAP: contextvars.ContextVar = contextvars.ContextVar("praxis_frame_layout", default=None)
_STRICT_OVERRIDE: bool | None = None


