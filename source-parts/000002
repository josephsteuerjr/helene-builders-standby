        self.assertIsNotNone(seen["meta"], "боевая расписка осталась без следа")
        self.assertTrue(seen["meta"]["honesty"]["ok"])
        self.assertEqual(seen["meta"]["covers"],
                         ["persona", "dynamic", "evidence", "situation"])

