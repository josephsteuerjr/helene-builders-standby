    struct Supervisor {
        body: PathBuf,
        config: PathBuf,
        state_dir: PathBuf,
        mode: ChildMode,
        stopping: AtomicBool,
        reconnect: AtomicBool,
        child: Mutex<Option<ManagedChild>>,
