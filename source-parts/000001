        let (tx, mut rx) = mpsc::channel(2);
        enqueue_response_then_ack(
            &runtime,
            &tx,
            Frame::Result {
                request_id: "request".into(),
                operation_id: "operation".into(),
                status: OperationStatus::Succeeded,
                ok: true,
                result: serde_json::json!({"ok": true}),
                artifacts: Vec::new(),
            },
