                sink.write(json.dumps({"chat_id": chat_id, "run_id": "run-" + chat_id,
                                       "held": "", "title": ctx.title}) + "\n")
        finally:
            self._TURN_CHANNEL.reset(token)
        return _Envelope("run-" + chat_id)

