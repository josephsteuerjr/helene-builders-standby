            return None
        uncertain = False
        for line in result.stdout.splitlines():
            fields = line.split()
            if len(fields) != 2 or not fields[0].isdigit():
                uncertain = True
                continue
            if int(fields[0]) == pgid and fields[1][:1].upper() not in {"Z", "X"}:
                return True
        return None if uncertain else False
    try:
        entries = list(Path("/proc").iterdir())
    except OSError:
