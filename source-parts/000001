.images-options .choice-text { line-height: 1.45; }
.images-options > .images-login { margin-top: 20px; padding-top: 14px; border-top: 1px solid var(--line); }

.composer-meta { max-width: 800px; margin: 0 auto 8px; padding: 0 14px; display: flex; align-items: center; flex-wrap: wrap; gap: 6px 16px; min-height: 22px; }
.composer-meta .composer-target { position: static; flex: 1 1 220px; min-width: 0; overflow-wrap: anywhere; padding: 0; font-size: 13px; line-height: 1.45; letter-spacing: 0; color: var(--ink-2); font-weight: 600; text-transform: none; }
.composer-meta .composer-status { position: static; flex: 0 1 auto; min-width: 0; max-width: 100%; margin: 0; padding: 0; background: none; flex-wrap: wrap; }
.composer-meta .composer-activity { text-align: right; color: var(--ink-2); }
.composer-meta:has(.composer-target:empty):not(:has(.composer-activity:not(:empty), .turn-receipt:not(:empty), .composer-turn-controls > button:not([hidden]))) { display: none; }
