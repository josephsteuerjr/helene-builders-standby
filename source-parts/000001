            prev = ""
            try:
                prev = marker.read_text(encoding="utf-8").strip()[:300]
            except OSError:
                pass
            return (frame_language.text('lifecycle.result.restart_recent', age=int(age), previous=(' — «'+prev+'»') if prev else ''))
