        self.root.mkdir()
        lay_out(self.root, {"helene.json": ROOT_CFG})

    def seed_file(self) -> Path:
        path = Path(self.tmp.name) / "seed.md"
        path.write_text(SEED, encoding="utf-8", newline="\n")
        return path


