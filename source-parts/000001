      ...Object.fromEntries((["dayColor", "nightColor", "accentColor"] as const).map(k => [k, /^#[0-9a-f]{6}$/i.test(raw[k] || "") ? raw[k] : ""])) as Pick<Look,"dayColor"|"nightColor"|"accentColor">,
    };
  } catch {
