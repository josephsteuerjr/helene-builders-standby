    print(f"Заявка {oid}")
    print(f"  путь:    {d.get('path')}")
    print(f"  зачем:   {d.get('reason') or '—'}")
    print(f"  создана: {d.get('created')}")
    print(f"  рельсы:  {rails_check(d.get('path','')) or 'ок'}")
    print("\n--- дифф против текущего файла хоста ---")
    print(_diff(d.get("path", ""), content))
