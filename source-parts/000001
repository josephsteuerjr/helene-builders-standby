  const electron = ua.match(/Electron\/([\d.]+)/)?.[1];
  const w = window as unknown as Record<string, unknown>;
  const os = /Windows/.test(ua) ? "Windows" : /Mac OS X/.test(ua) ? "macOS" : /Linux/.test(ua) ? "Linux" : "?";
