}
#view .usage-summary-title {
  grid-column: 1;
}
#view .usage-summary-toggle {
  grid-column: 2;
  justify-self: end;
  align-self: center;
}
#view .usage-brief {
  grid-column: 1;
}
#view .usage-limits-brief {
  grid-column: 2;
  flex-direction: column;
  gap: 10px;
}

/* Полоса кадра — различима и при дейтеранопии: зелёный, ржавый и коричневый одной
   светлоты сливались. Теперь куски различаются светлотой (кэш — светлый, заново —
   насыщенный, ответ — средний), а между ними — просвет бумаги. */
.frame-bar {
  gap: 2px;
  background: transparent;
}
.frame-bar i {
  border-radius: 3px;
}
.frame-bar .cached,
.frame-legend .cached i {
  background: color-mix(in srgb, var(--ok) 45%, var(--paper));
}
.frame-bar .fresh,
.frame-legend .fresh i {
