.run-actions > summary::-webkit-details-marker,
.action-earlier > summary::-webkit-details-marker,
.action-details > summary::-webkit-details-marker {
  display: none;
}
.run-actions > summary::after,
.action-earlier > summary::after,
.action-details > summary::after {
  content: "⌄";
  display: inline-block;
  margin-left: 0.45em;
  transition: transform 0.15s ease;
}
.run-actions[open] > summary::after,
.action-earlier[open] > summary::after,
.action-details[open] > summary::after {
  transform: rotate(180deg);
}
.run-actions > summary:hover,
.action-earlier > summary:hover,
.action-details > summary:hover,
.run-reading-more summary:hover span,
.usage-summary:hover .usage-summary-toggle {
  color: var(--ink-2);
