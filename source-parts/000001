        connection
            .execute(
                "UPDATE frames SET created_at=?2 WHERE message_id=?1",
                params![
                    rollback_clock.message_id.to_string(),
                    (Utc::now() - Duration::hours(1)).to_rfc3339()
                ],
            )
            .unwrap();
