/* Таксономия. Ржавый — только то, что нажимается. Переход в другое место — ржавый со
   стрелкой «→»; разворот на месте — серый со стрелкой «⌄» (раскрыт — стрелка вверх). */
.turn-live-sub {
  color: var(--muted);
}
.run-actions > summary,
.action-earlier > summary,
.action-details > summary {
  list-style: none;
  color: var(--muted);
  cursor: pointer;
