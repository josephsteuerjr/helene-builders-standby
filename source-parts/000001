# решение принимается здесь, и скан с lookahead обошёлся бы заметно дороже.
_EXOTIC_RE = re.compile("[" + "".join(sorted(BREAKS.values()))
                        + chr(0xD800) + "-" + chr(0xDFFF) + "]")
