    #[test]
    fn an_early_supervisor_failure_is_a_recorded_outcome_not_a_shrug() {
        let root = std::env::temp_dir().join(format!("praxis-process-early-{}", Uuid::new_v4()));
        let operation_id = "op-early-fail";
