                self.assert_archived(transport, life, '-100777')
                self.assertEqual(list(transport._pending), ['-100777'])
                transport.on_incoming.assert_called_once()
                self.assertEqual(transport.on_incoming.call_args.kwargs['sender_id'], '22')

