/* ---------------------------------------------------------------- рамка фокуса */

/* Физика прокрутки берёт фокус на себя при «тянуть мышью» (чтобы работали стрелки и
   PageDown) — обводка фокуса вокруг всей средней части выглядела бы рамкой-ошибкой
   (владелец 28.09: «стало менее няшно»). Фокус у прокрутки есть, рамки нет. */
#view:focus,
#view:focus-visible,
