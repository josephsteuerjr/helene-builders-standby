def plain_body(text: str) -> str:
    """Снять разметку, НЕ трогая слов.

    Нумерация списков (`1. `) НЕ снимается намеренно: её цифры неотличимы от слов, и
    снятие ломает единственное проверяемое свойство этого шва — «набор слов совпадает».
    Цена мала: по замеру нумерация встречается в 1,5–7% ответов против 44% у жирного.
    """
    t = _MD_BOLD.sub(r"\1", text or "")
    t = _MD_ITAL.sub(r"\1", t)
    t = _MD_HEAD.sub("", t)
    t = _MD_BULL.sub(r"\1", t)
    return t

