                    "  ok  fixture\nвсе зелёные\n" if name == "desk" else
                    "WINDOWS_SAFE_PASSED=1\n" if name == "windows-safe" else
                    "test result: ok. 1 passed; 0 failed\n" if name in {"body", "relay"} else
