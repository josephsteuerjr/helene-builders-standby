/* Колонка ленты в em: масштаб (Ctrl+колесо) растит её вместе с текстом. */
.center.talk {
  max-width: none;
}
.talk-zoom {
  font-size: calc(var(--feed-base) * var(--zoom));
  max-width: 46em;
  margin: 0 auto;
}
/* Промежутки — внутри строки (padding), а не полями: новое сообщение вырастает из нуля
   целиком, вместе со своим отступом (ui-kit/feed/keyed.ts: grow). */
.talk .feed {
  padding-bottom: 0.4em;
}
