pub const ATTRIBUTE_NAMES: [&str; 15] = [
    "AXRole",
    "AXSubrole",
    "AXTitle",
    "AXDescription",
    "AXLabel",
    "AXHelp",
    "AXRoleDescription",
    "AXIdentifier",
