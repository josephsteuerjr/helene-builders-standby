.rail-sign {
  font-family: var(--hand);
  font-size: 14px;
  margin: 0 0 0 6px;
  line-height: 1.3;
  white-space: nowrap;
}
.dot.live,
.agent-dot {
  background: var(--terra);
}

/* ---------------------------------------------------------------- шапка */

.head-kicker {
  font: 400 12px/1 var(--sans);
  letter-spacing: 0.02em;
  text-transform: none;
  color: var(--ink-3);
}
.head-title,
.head-title.hand {
  font: 400 32px/1.15 var(--hand);
  letter-spacing: 0.03em;
  -webkit-text-stroke: 0.4px currentColor;
}
.state-pill {
  border: var(--lw) solid transparent;
  background: transparent;
  box-shadow: none;
}

