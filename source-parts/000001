_LOCK = threading.RLock()
# A claim is a lease, not merely a marker.  The flock is held for the whole
# rebuild, so an old wall-clock timestamp can never make another worker steal
# a still-running builder.  PID is informational only (it can be reused).
_REFRESH_CLAIM_LEASE_SECONDS = 6 * 60 * 60
_CLAIM_FDS: dict[str, int | None] = {}
_CLAIM_BUILDER_FDS: dict[str, int] = {}
# ⚠ WINDOWS (издание Hélène). Её механизм заявок стоит на POSIX: `flock` на открытом
# описании файла и `rename`/`unlink` заявки при ОТКРЫТОМ дескрипторе. На Windows `flock`
# нет вовсе, а `os.open` не даёт FILE_SHARE_DELETE — открытый файл нельзя ни
# переименовать, ни удалить. Взятый как есть, захват падал бы OSError → «заявка есть,
# захватить не вышло» → `memory_index.build` не пересобирал бы индекс НИКОГДА (pending без
# claim — пропуск), а явный recall после сбоя базы молчал бы до конца времён.
# Поэтому на Windows единственный живой замок — замок сборщика (`msvcrt.locking`, байт 0
# стабильного `recall_builder.lock`), а заявка — просто данные. Все, кто трогает заявки
# (`claim_refresh_request`, `memory_index._build_owned`), держат замок сборщика; значит,
# чужая заявка, увиденная под нашим замком, осиротела — её сборщик умер, не отпустив
# (окно издания закрывают посреди пересборки, это обычный случай, а не авария).
_WINDOWS = os.name == "nt"
_WINDOWS_LOCK_WAIT_SECONDS = 600.0
