        lines = _read(GRAPH_MD).splitlines()
        keep = [l for l in lines if not (f"[[{a}]]" in l and f"[[{b}]]" in l)]
        if len(keep) != len(lines):
            removed += len(lines) - len(keep)
            GRAPH_MD.write_text("\n".join(keep).rstrip() + "\n", encoding="utf-8")
