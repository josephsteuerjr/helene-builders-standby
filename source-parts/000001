def path_state(path) -> str:
    try:
        if path.is_symlink():
            return 'symlink -> ' + os.readlink(path)
        if path.is_dir():
            return 'directory'
        if path.is_file():
            kind = _fingerprint(path)
            return f'file sha256={kind[1]} bytes={path.stat().st_size}'
    except OSError as exc:
        return f'unreadable: {type(exc).__name__}'
    return 'missing'


