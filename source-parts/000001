_TOOL_CATALOG: ContextVar["dict | None"] = ContextVar("praxis_tool_catalog", default=None)

def tool_pointers_enabled() -> bool:
    """Старые call/describe указатели; off — все схемы родные (h.hand только для скриптов)."""
    return str(os.getenv("PRAXIS_TOOLS_POINTERS", "off") or "off").strip().lower() not in {
        "0", "off", "false", "no"}


def _hand_purpose(tool: dict) -> str:
    """Строка указателя про руку. Английская проекция — той же накладкой, что схемы.

    ⚠ Без неё «Кадр — да» отменяет «Англ — да»: указатель заменяет сотню схем своими
    строками, и русский текст выбросил бы английские описания 86 рук из 95.
    """
    name = str(tool.get("name") or "")
    localized = tool_language.purpose(tool)
    if localized:
        return localized
    known = HAND_PURPOSE.get(name)
    if known and tool_language.known(tool):
        return tool_text_en.pointer_purpose(name, known)
    text = " ".join(str(tool.get("description") or "").split())
    first = re.split(r"(?<=[.!?])\s", text, maxsplit=1)[0] if text else ""
    return (first[:88] + "…") if len(first) > 90 else (first or frame_language.text('schema.no_description'))


def _hand_signature(tool: dict, *, limit: int | None = 6) -> str:
    """`fs_read(path, start?, end?)` — по схеме руки: обязательные без знака, остальные с «?».

    13.09: строка «имя — назначение» без аргументов заставляла звать `describe` перед каждой
    новой рукой (27 из 193 вызовов за вечер). Сигнатура в одну строку снимает почти все
    эти вызовы: по ней `call` зовётся сразу, а `describe` остаётся для перечислений и
    вложенных объектов.
    """
    name = str(tool.get("name") or "")
    schema = tool.get("input_schema") if isinstance(tool.get("input_schema"), dict) else {}
    props = schema.get("properties") if isinstance(schema.get("properties"), dict) else {}
    required = [str(x) for x in (schema.get("required") or []) if str(x) in props]
    ordered = required + [p for p in props if p not in required]
    parts = [p if p in required else f"{p}?" for p in ordered[:limit]]
    if limit is not None and len(ordered) > limit:
        parts.append("…")
    return f"{name}({', '.join(parts)})"


