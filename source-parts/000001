            original=path.stat().st_mtime_ns;seen=config_cli.mtime_ns(path)
            factory=config_cli.tempfile.NamedTemporaryFile
            @contextlib.contextmanager
            def same_tick(**kwargs):
                with factory(**kwargs) as output:yield output
