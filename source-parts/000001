        self.assertEqual(history[2]["content"], "вторая\n\nещё")
        self.assertEqual(current, "сейчас")
        self.assertEqual([[r["event"] for r in g] for g in sidecar["history"]],
                         [["e0"], ["e1"], ["e2", "e3"], ["e4"]])
        self.assertEqual([r["event"] for r in sidecar["current"]], ["e5"])

