fn safe_operation_id(value: &str) -> Result<&str> {
    if value.is_empty()
        || value.len() > 96
        || !value
            .bytes()
            .all(|b| b.is_ascii_alphanumeric() || b == b'-' || b == b'_')
    {
        anyhow::bail!("invalid operation id");
    }
    Ok(value)
}

