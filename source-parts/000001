            f"{_today()} {_now()} — {reason or 'без причины'} (моё решение, restart_self)",
            encoding="utf-8")
    except Exception:
        log.debug("restart_reason не записался", exc_info=True)
    # 01.08.2026: её собственный перезапуск ГАСИТ заявку контура — он её удовлетворяет.
