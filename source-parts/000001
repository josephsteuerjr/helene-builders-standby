/* Optional looks preserve the paper default and all current content. */
:root[data-look-style="clean"] { --hand: "Golos Text", "Segoe UI", system-ui, sans-serif; --grain: 0; }
:root[data-look-style="clean"] .card { border-radius: 5px; }
