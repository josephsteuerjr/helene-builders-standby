def _read_page(path: Path, root: Path, raw: bytes, *, start: int, end: int,
               start_char: int, expected_sha256: str, display_path: str = "") -> str:
    """Return an exact, source-bound UTF-8 slice that fits the worker's result budget.

    Offsets count Unicode code points within physical lines (including their newline).
    JSON is used so newlines and long-line continuation remain unambiguous. The
    source hash is over bytes, rather than decoded/re-encoded text.
    """
    digest = hashlib.sha256(raw).hexdigest()
    expected = str(expected_sha256 or "").strip().lower()
    if expected and expected != digest:
        return InspectReply(frame_language.text('forge.io.26', v1=f'{expected}', v3=f'{digest}'),
                            "refused")
    try:
        lines = raw.decode("utf-8").splitlines(keepends=True)
    except UnicodeDecodeError:
        return InspectReply(frame_language.text('forge.io.27', v0=f'{display_path or path.relative_to(root)}', v2=f'{len(raw)}', v4=f'{digest}'), "refused")
    s = max(1, int(start or 1))
    offset = int(start_char or 0)
    if offset < 0 or (offset and not expected):
        return InspectReply(frame_language.text('forge.io.28'), "refused")
    if s <= len(lines) and offset > len(lines[s - 1]):
        return InspectReply(frame_language.text('forge.io.29', v1=f'{offset}', v3=f'{s}', v5=f'{len(lines[s - 1])}'), "refused")
    if s > len(lines) and offset:
        return InspectReply(frame_language.text('forge.io.30', v1=f'{offset}', v3=f'{len(lines)}'), "refused")
    if s <= len(lines) and offset == len(lines[s - 1]):
        s, offset = s + 1, 0
    stop = min(len(lines), int(end or len(lines)))
    base = {"path": display_path or str(path.relative_to(root)), "sha256": digest,
            "start": s, "start_char": offset, "total_lines": len(lines),
            "requested_end": int(end or 0)}

    def make_page(text: str, next_line: int, next_offset: int) -> str:
        return json.dumps({**base, "text": text, "next_start": next_line,
                           "next_char": next_offset, "complete": next_line > len(lines),
                           "omitted_before": s > 1 or offset > 0,
                           "omitted_after": next_line <= len(lines)}, ensure_ascii=False)

    if s > stop:
        page = make_page("", s, 0)
        return page if len(page) <= 8000 else frame_language.text('forge.io.31')
    # Bound candidate material before JSON escaping; binary search handles control
    # characters (and quoted/backslash-heavy source) whose wire size is larger.
    chunks = []
    remaining = 7900
    for i in range(s - 1, stop):
        fragment = lines[i][offset if i == s - 1 else 0:]
        part = fragment[:remaining]
        chunks.append(part)
        remaining -= len(part)
        if remaining <= 0 or len(part) < len(fragment):
            break
    candidate = "".join(chunks)

    def cursor(count: int) -> tuple[int, int]:
        line_no, char_no, left = s, offset, count
        while line_no <= stop and left:
            available = len(lines[line_no - 1]) - char_no
            taken = min(left, available)
            char_no += taken
            left -= taken
            if char_no == len(lines[line_no - 1]):
                line_no, char_no = line_no + 1, 0
        return line_no, char_no

    low, high, best = 0, len(candidate), ""
    while low <= high:
        mid = (low + high) // 2
        line_no, char_no = cursor(mid)
        page = make_page(candidate[:mid], line_no, char_no)
        if len(page) <= 8000:
            best, low = page, mid + 1
        else:
            high = mid - 1
    if not best or (candidate and not json.loads(best)["text"]):
        return frame_language.text('forge.io.32')
    return best


