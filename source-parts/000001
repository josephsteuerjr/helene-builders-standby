class MediaAudio:
    """Small pluggable facade used by the Telegram/application layer."""

    def __init__(
        self,
        config: AudioConfig | None = None,
        *,
        stt: SpeechToText | None = None,
        tts: TextToSpeech | None = None,
    ) -> None:
        # Freeze input at construction, but parse synthesis-only values only
        # when synthesis is requested. A malformed TTS timeout is not STT config.
        self._tts_environ = dict(os.environ) if config is None else None
        recognition_env = {k: v for k, v in (self._tts_environ or {}).items()
                           if not k.startswith(('PRAXIS_TTS_', 'PRAXIS_EDGE_', 'PRAXIS_PIPER_'))}
        self.config = config or AudioConfig.from_env(recognition_env)
        self.stt = stt or FasterWhisperSTT(self.config)
        self._tts = tts
        self._tts_lock = threading.Lock()

    @property
    def tts(self):
        # An unrelated synthesis setting or optional TTS import must never
        # prevent incoming speech recognition. Construct only on a TTS request.
        with self._tts_lock:
            if self._tts is None:
                config = AudioConfig.from_env(self._tts_environ) if self._tts_environ is not None else self.config
                self._tts = self._create_tts(config)
            return self._tts

    def _create_tts(self, config):
        if config.tts_backend in ("disabled", "none", "off"):
            raise AudioConfigurationError((self._tts_environ or {}).get('HELENE_TTS_REASON') or "Speech synthesis is disabled")
        if config.tts_backend == "xtts":
            return XTTSTTS(config)
        if config.tts_backend == "piper":
            return PiperTTS(config)
        elif config.tts_backend == "silero":
            try:
                from silero_tts_client import SileroTTSConfig, SileroTTSClient
            except ImportError as exc:
                raise AudioDependencyError(
                    "isolated Silero TTS support is unavailable"
                ) from exc
            return FallbackTTS(
                SileroTTSClient(
                    SileroTTSConfig.from_env(output_dir=config.output_dir)
                ),
                PiperTTS(config),
            )
        elif config.tts_backend == "edge":
            return FallbackTTS(EdgeTTS(config), PiperTTS(config))
        else:
            raise AudioConfigurationError(
                "PRAXIS_TTS_BACKEND must be xtts, edge, piper, or silero, "
                f"got {config.tts_backend!r}"
            )

    def transcribe(self, path: str | os.PathLike[str]) -> str:
        return self.stt.transcribe(path)

    def synthesize(self, text: str, *, stopped=None) -> Path:
        if stopped is not None and stopped():raise InterruptedError('Speech synthesis cancelled; no audio sent')
        backend = self.tts
        path = backend.synthesize(text, stopped=stopped) if isinstance(backend, XTTSTTS) else backend.synthesize(text)
        if stopped is not None and stopped():
            Path(path).unlink(missing_ok=True)
            raise InterruptedError('Speech synthesis cancelled; no audio sent')
        return path

    def clear_caches(self) -> None:
        for backend in (self.stt, self._tts):
            clear = getattr(backend, "clear_cache", None)
            if callable(clear):
                clear()


_default_backend: MediaAudio | None = None
_default_backend_lock = threading.Lock()


def set_default_backend(backend: MediaAudio | None) -> None:
    """Replace/reset the process-wide facade (primarily for wiring and tests)."""

    global _default_backend
    with _default_backend_lock:
        _default_backend = backend


def get_default_backend() -> MediaAudio:
    global _default_backend
    if _default_backend is not None:
        return _default_backend
    with _default_backend_lock:
        if _default_backend is None:
            _default_backend = MediaAudio()
        return _default_backend


def transcribe(path: str | os.PathLike[str]) -> str:
    """Transcribe a local audio file using the configured local backend."""

    return get_default_backend().transcribe(path)


def synthesize(text: str, *, stopped=None) -> Path:
    """Synthesize one unique artifact; never stage cancelled speech."""
    backend = get_default_backend()
    return backend.synthesize(text) if stopped is None else backend.synthesize(text, stopped=stopped)


def warm(*, stt: bool = True, tts: bool = True) -> dict[str, str]:
    """Eagerly load the STT (and local TTS) models into the resident cache so they are
    in memory FROM BOOT, not lazily on the first voice.  ``keep_loaded`` then holds them.
    Best-effort by contract: this must NEVER raise — a warmup failure must not stop the
    process booting; the models simply fall back to their lazy first-use load path.
    """
    result: dict[str, str] = {}
    backend = get_default_backend()
    if stt:
        try:
            loader = getattr(backend.stt, "_get_model", None)
            if callable(loader):
                loader()
                result["stt"] = "loaded"
            else:
                result["stt"] = "no-loader"
        except Exception as exc:  # noqa: BLE001 — warmup is strictly best-effort
            result["stt"] = f"{type(exc).__name__}: {exc}"
    if tts:
        try:
            if bool(getattr(backend.tts, "skip_warmup", False)):
                result["tts"] = "lazy-isolated"
                return result
            loader = getattr(backend.tts, "_get_model", None)
            if callable(loader):
                loader()
            else:
                synthesize("прогрев")  # local piper loads its model into cache
            result["tts"] = "loaded"
        except Exception as exc:  # noqa: BLE001 — warmup is strictly best-effort
            result["tts"] = f"{type(exc).__name__}: {exc}"
    return result


