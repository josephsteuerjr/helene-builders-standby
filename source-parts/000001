  scrollbar-width: thin;
  scrollbar-color: var(--line-strong) transparent;
}

/* ---------------------------------------------------------------- «Вид» в настройках */

.look-card .look-row {
  display: grid;
  grid-template-columns: 150px 1fr;
  gap: 6px 14px;
  align-items: center;
  padding: 12px 0;
