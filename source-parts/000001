    pub capabilities: Vec<String>,
    pub available: bool,
}

#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
pub struct CapabilityManifest {
    pub protocol: String,
    pub body_version: String,
    pub device_id: String,
    pub hostname: String,
    pub os: String,
    pub arch: String,
