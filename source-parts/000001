@contextmanager
def exclusive(path, *, timeout=120.0):
    """Исключительный межпроцессный замок файла `path` (создаётся при нужде).

    POSIX — fcntl.flock, как и было. Windows — msvcrt.locking на первый байт того же
    файла: тоже исключительный и тоже снимается ядром, если процесс умер. Ждём
    короткими шагами, а не по секунде (LK_LOCK), и не вечно: не взятый за `timeout`
    замок — отказ контракта, вызывающий уходит на прежний путь, а не висит.
    """
    import time
    with open(path, 'a+b') as stream:
        try:
            import fcntl
        except ImportError:
            fcntl = None
        if fcntl is not None:
            fcntl.flock(stream, fcntl.LOCK_EX)
            try:
                yield
            finally:
                fcntl.flock(stream, fcntl.LOCK_UN)
            return
        import msvcrt
        deadline = time.monotonic() + float(timeout)
        while True:
            stream.seek(0)
            try:
                msvcrt.locking(stream.fileno(), msvcrt.LK_NBLCK, 1)
                break
            except OSError:
                if time.monotonic() >= deadline:
                    raise ContractError('lock timeout')
                time.sleep(0.02)
        try:
            yield
        finally:
            stream.seek(0)
            msvcrt.locking(stream.fileno(), msvcrt.LK_UNLCK, 1)


