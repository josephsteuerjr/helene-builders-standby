    def write(self):
        self.config.write_text(json.dumps(self.cfg), encoding='utf8')

    def request(self, capability='desktop.element.find', **fields):
        value = {'capability': capability, 'request_id': 'req-1', 'execution': 'interactive', 'args': {}}
        value.update(fields)
