#[derive(Clone)]
pub struct ArtifactStore {
    root: PathBuf,
    chunk_size: u64,
}

#[derive(Debug, Clone, Serialize, Deserialize)]
struct IncomingMeta {
    artifact: ArtifactRef,
    chunk_size: u64,
}

#[derive(Debug, Deserialize)]
