                    answer = readers.safe_write_md('memory/notes/log.md', doc['text'], stamp)
                    self.assertEqual(answer.get('code'), 'tail_readonly')
                    self.assertEqual(path.read_bytes(), original)
                    self.assertFalse(path.with_suffix('.md.bak').exists())

