        "roster": ROSTER,
        "frame_id": trace.frame_id,
        "basis": "live",
        "emit": 1,
        "mode": trace.mode,
        "system_form": trace.system_form,
        # Что измерено и что НЕТ — в самом конверте, а не в докстринге. Сумма bytes трёх
