                receipt = bot.deliver_file(path, chat_id="123", media_kind="photo")
        self.assertEqual(len(calls), 2, "ровно один повтор, не больше")
        self.assertAlmostEqual(sum(call.args[0] for call in slept.call_args_list), 2.1)
