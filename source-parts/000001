def _native_hands() -> frozenset:
    raw = os.getenv("PRAXIS_NATIVE_HANDS")
    if raw is None:
        return _NATIVE_CORE | _NATIVE_BY_USE
    extra = {x.strip() for x in raw.split(",") if x.strip()}
    return _NATIVE_CORE | frozenset(extra)


