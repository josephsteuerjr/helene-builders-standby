    try:
        beat(lease_sec=20)
        pid = _spawn_runner(script, directory / "request.json", directory / "supervisor.log")
    except Exception as exc:
        failure = {"status": "error", "finished": _now(),
                   "error": f"{type(exc).__name__}: {exc}", "reported_inline": True}
