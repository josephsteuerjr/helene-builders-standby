}

#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
pub struct ExecutionContextCapability {
    pub kind: ExecutionKind,
    pub available: bool,
    #[serde(default, skip_serializing_if = "Option::is_none")]
    pub identity: Option<ExecutionIdentity>,
    #[serde(default, skip_serializing_if = "Option::is_none")]
