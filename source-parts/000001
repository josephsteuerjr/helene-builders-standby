_LOG_LINE_CLIP = 280


@frame_language.pinned
def tool_read_log(query: str = "", lines: int | None = None, unit: str = "") -> str:
    """Owner: её собственный runner-лог (logsink: memory/.logs/praxis.log + ротация) —
    хвост или greп по подстроке. Техническое зеркало: строки MSG несут id отправителей
    (кейс 09.07 «не вижу айди спамера» — id был в логе, руки не было), сюда же падают
    HTTP-ошибки мозга. Файлы переживают пересоздание контейнера, docker logs — нет."""
    if unit:
        if query:
            raise catalog_families.PreflightRefusal(frame_language.text('run.result.log_unit'))
        return tool_server_logs(unit, 60 if lines is None else lines)
    import logsink
    try:
        lines = max(1, min(120, int(40 if lines is None else lines)))
    except (TypeError, ValueError):
        lines = 40
    q = (query or "").strip().lower()
    rows: list[str] = []
    for fname in ("praxis.log.1", "praxis.log"):   # старый → новый: хвост хронологичен
        p = logsink.LOGS_DIR / fname
        if not p.exists():
            continue
        try:
            rows.extend(p.read_text(encoding="utf-8", errors="ignore").splitlines())
        except OSError:
            continue
    if q:
        rows = [r for r in rows if q in r.lower()]
    tail = rows[-lines:]
    if not tail:
        return frame_language.text('run.result.log_none', query=(frame_language.text('run.result.log_query', query=query) if q else ''))
    shown = '\n'.join(r[:_LOG_LINE_CLIP] for r in tail)
    omitted = max(0,len(shown)-7000)
    clipped_lines = sum(len(r)>_LOG_LINE_CLIP for r in tail)
    shown = shown[-7000:]
    return (frame_language.text('run.result.log_cut', text=shown, cap=_LOG_LINE_CLIP, lines=clipped_lines, omitted=omitted) if omitted or clipped_lines else shown)


# Разведчик — свежие глаза без её персоны и памяти, read-only руки; отчёт ЕЙ.
# Единственное заимствование из «роя» ouroboros, по идее владельца: «сбор информации
# о ней со стороны». Один разведчик за раз — никакого роя и best-of-N.
# 17.A/B: дом — это и машина под ней. Разведчику дано только СМОТРЕТЬ (status, logs);
# manage_service сюда не входит по построению — разведчик ничего не меняет.
_SCOUT_TOOL_NAMES = ("fs_read", "fs_search", "fs_ls", "code_outline", "recall", "read_log",
                     "server_status")


@frame_language.pinned
def second_look(brief: str) -> str:
    """PASS 16.2: ограниченный прогон свежим контекстом (без персоны) с read-only руками.
    Возврат — отчёт ей + строка в журнал. Тулы вне _SCOUT_TOOL_NAMES недоступны по построению."""
    if not (brief or "").strip():
        return frame_language.text('owned.agent.45c211521591')
    pool = list(BASE_TOOLS) + list(OWNER_TOOLS)
    tools = tool_language.apply(
        [t for t in pool if t.get("name") in _SCOUT_TOOL_NAMES], fallback=tool_text_en.apply)
    messages = [{"role": "user", "content": frame_language.text('prompt.brief', brief=brief.strip())}]
    report = ""
    try:
        for _ in range(llm.limits().max_tool_iters):
            # Разведчик — рука хода: его вызовы тоже не пережидают стопа (05.10).
            resp = _chat_cancellable("voice", system=frame_language.text('prompt.scout'), messages=messages, tools=tools)
            if resp.stop_reason == "tool_use":
                blocks, results = [], []
                for b in resp.blocks:
                    if b["type"] == "text":
                        blocks.append(b)
                    elif b["type"] == "tool_use":
                        blocks.append(b)
                        impl = TOOL_IMPL.get(b["name"]) if b["name"] in _SCOUT_TOOL_NAMES else None
                        call = {k: v for k, v in b["input"].items() if v is not None}
                        out = impl(**call) if impl else frame_language.text('owned.agent.7bd9023adfc6', v0=b['name'])
                        results.append({"type": "tool_result", "tool_use_id": b["id"],
                                        "content": str(out)[:2000]})
                messages.append({"role": "assistant", "content": blocks})
                messages.append({"role": "user", "content": results})
                continue
            report = _strip_think(resp.text).strip()
            break
    except Exception:
        log.warning("second_look упал", exc_info=True)
        return frame_language.text('owned.agent.8d87662b2ec6')
    report = report or frame_language.text('owned.agent.b3a451a57be4')
    try:
        tool_journal(frame_language.text('owned.agent.184eac6aac40', v0=brief.strip()[:80], v1=report[:180]), salience=2)
    except Exception:
        log.debug("journal разведки не записался", exc_info=True)
    return report[:6000]


