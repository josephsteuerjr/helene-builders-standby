def _tree(root: Path, token: str | None = "a" * 32) -> Path:
    state = root / "memory" / ".state"
    state.mkdir(parents=True, exist_ok=True)
    if token is not None:
        (state / "broker-token").write_text(token + "\n", encoding="utf-8")
    return root


