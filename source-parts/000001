                lay_out(root, case["files"])
                got = agents.roster(root)
                self.assertEqual([a.id for a in got], [e["id"] for e in case["expect"]],
                                 case["name"])
                for mine, want in zip(got, case["expect"]):
                    self.assertEqual(mine.name, want["name"], case["name"])
