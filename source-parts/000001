        for (capability, args) in [
            (CAPABILITY, json!({})),
            (crate::element::FIND_CAPABILITY, json!({"select": {"role": "button"}})),
            (crate::element::CAPABILITY, json!({"do": "focus", "select": {"role": "button"}})),
        ] {
