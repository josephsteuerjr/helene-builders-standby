            "automatic_canonical": purpose == "automatic",
            "event_id": row["event_id"], "run_id": row["run_id"],
            "desire_id": row.get("desire_id") or "",
            "refs": refs, "supersedes": supersedes, "provenance": provenance,
            "index": SCHEMA_VERSION,
