}
.look-pill {
  height: 32px;
  padding: 0 14px;
  border: var(--lw) solid var(--line-ink);
  border-radius: 999px;
  background: transparent;
  color: var(--ink);
  font: 400 13.5px/1 var(--sans);
  cursor: pointer;
}
.look-pill:hover {
  background: var(--ctrl-hover);
}
.look-pill[aria-checked="true"] {
  background: var(--ink);
  color: var(--paper);
}
.look-reset {
  margin-top: 12px;
  height: 32px;
  padding: 0 14px;
  border: var(--lw) dashed var(--line-strong);
