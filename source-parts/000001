        let replay = reopened
            .pending("pc", TO_CONTROLLER)
            .unwrap()
            .iter()
            .map(|raw| serde_json::from_str::<Envelope>(raw).unwrap())
            .collect::<Vec<_>>();
        let sequences = replay
            .iter()
            .map(|envelope| envelope.seq)
            .collect::<Vec<_>>();
        assert_eq!(sequences, vec![1, 2, 3]);
        assert_eq!(
            replay
                .iter()
                .map(|envelope| envelope.message_id)
                .collect::<Vec<_>>(),
            insertion_order
        );
